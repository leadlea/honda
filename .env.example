# Honda Veteran Talent Matching System - Environment Variables

# Deployment Stage
STAGE=dev

# AWS Configuration
AWS_REGION=us-west-2
AWS_PROFILE=default

# Bedrock Configuration
BEDROCK_ENABLED=true
BEDROCK_PRIMARY_REGION=us-west-2
BEDROCK_FALLBACK_REGIONS=us-east-1,eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_DELAY=1.0
BEDROCK_TIMEOUT=300
BEDROCK_MAX_TOKENS=4000
BEDROCK_TEMPERATURE=0.7
BEDROCK_TOP_P=0.9
BEDROCK_LOG_LEVEL=INFO

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=honda-veteran-talent-matching-dev

# Cognito Configuration (populated after deployment)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# API Configuration
API_GATEWAY_URL=

# Frontend Configuration
REACT_APP_API_URL=
REACT_APP_COGNITO_USER_POOL_ID=
REACT_APP_COGNITO_CLIENT_ID=
REACT_APP_STAGE=dev

# Serverless Framework
SERVERLESS_ACCESS_KEY=

# Development
DEBUG=true
LOG_LEVEL=INFO